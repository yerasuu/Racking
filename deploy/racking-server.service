# systemd USER unit for racking-server.
# Install to ~/.config/systemd/user/racking-server.service (deploy/install.sh does it).
# Hardening options were checked against systemd.exec(5) and systemd.service(5):
# https://www.freedesktop.org/software/systemd/man/latest/systemd.exec.html
# https://www.freedesktop.org/software/systemd/man/latest/systemd.service.html
[Unit]
Description=Racking server (agent job board)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/racking-server --config %h/.config/racking/server.toml
Restart=on-failure
RestartSec=3

# Hardening that works in a per-user manager (no root needed).
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
# Mount-namespace options: in a user manager they implicitly use an unprivileged
# user namespace (kernel.unprivileged_userns_clone). If the unit fails with
# status=226/NAMESPACE, delete the block below; see docs/deploy.md.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# SQLite writes the database, its -wal/-shm/-journal files and the attachments
# in the data dir, so that whole directory must stay writable.
ReadWritePaths=%h/.local/share/racking
# Left out on purpose: User=, DynamicUser=, PrivateUsers= and a privileged
# CapabilityBoundingSet= (not usable or pointless in a user manager);
# PrivateDevices=, ProtectKernelLogs=, ProtectClock= (they need privileges
# a user manager lacks unless a user namespace is available, and add little).

[Install]
WantedBy=default.target
